# Kimi K2 模型配置示例
# 请将此文件复制为 .env 并填入真实的 API 密钥

# Moonshot Kimi API 配置
DEFAULT_LLM_API_KEY="your-moonshot-api-key-here"
DEFAULT_LLM_BASE_URL="https://api.moonshot.cn/v1"
DEFAULT_LLM_MODEL_NAME="moonshot-v1-128k"

# 可选：其他 Kimi 模型
# DEFAULT_LLM_MODEL_NAME="moonshot-v1-32k"  # 32K 上下文版本
# DEFAULT_LLM_MODEL_NAME="moonshot-v1-8k"   # 8K 上下文版本

# 可选：数据库配置 (如果需要)
# ES_HOST_1="localhost:9200"
# REDIS_HOST="localhost"
# VEARCH_ROUTER_URL="http://localhost:9001"
